{
  "name": "@cyca/electron-sirv",
  "version": "0.1.4",
  "description": "Static file serving for Electron apps",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun test",
    "release": "varlock run -- npm publish --access public"
  },
  "devDependencies": {
    "mrmime": "^2.0.1",
    "totalist": "^3.0.1",
    "tsdown": "latest",
    "varlock": "^0.5.0"
  },
  "peerDependencies": {
    "electron": ">=32"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
